{
  "opencollection": "1.0.0",
  "info": {
    "name": "ReccoBeats Album Audio Analysis API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Audio Analysis",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Extract audio features",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.reccobeats.com/v1/analysis/audio-features",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "audioFile",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Extract audio features directly from an uploaded audio file. The file is sent as multipart/form-data. Supported formats are MP3, OGG/Vorbis, AIFF/AIFC, and WAV, up to 5 MB; only the first 30 seconds are analyzed and a 44,100 Hz sampling rate is recommended."
        }
      ]
    }
  ],
  "bundled": true
}